{
    "debug_logging": {
      "type": "bool",
      "description": "输出插件详细调试日志（可能包含查询摘要和数据统计，不包含完整提示词）",
      "default": false
    },
    "command_name": {
      "type": "string",
      "description": "菜单命令名称，可填写 X 以使用 /X；不能填写 q，请避免与其他机器人使用相同命令",
      "default": "sat"
    },
    "sync_on_start": {
      "type": "bool",
      "description": "插件启动时立即同步数据",
      "default": true
    },
    "sync_interval_hours": {
      "type": "float",
      "description": "自动同步间隔（小时）",
      "default": 24,
      "slider": {"min": 1, "max": 168, "step": 1}
    },
    "data_dir": {
      "type": "string",
      "description": "插件数据目录",
      "default": "data/plugin_data/astrbot_plugin_satellite_forecast"
    },
    "celestrak": {
      "type": "object",
      "description": "CelesTrak 或兼容格式的数据源",
      "items": {
        "endpoint": {"type": "string", "default": "https://celestrak.org/NORAD/elements/gp.php"},
        "group": {"type": "string", "default": "active"},
        "format": {"type": "string", "options": ["tle", "json"], "default": "tle"}
      }
    },
    "satnogs": {
      "type": "object",
      "description": "SatNOGS 或兼容格式的转发器数据源",
      "items": {
        "endpoint": {"type": "string", "default": "https://db.satnogs.org/api/transmitters/"}
      }
    }
}
